{
  "name": "cc98-searchpro",
  "version": "0.1.0",
  "description": "CC98-SearchPro：面向 MCP 的 CC98 搜索增强、正文验证与证据阅读。",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "cc98-searchpro": "runtime/server.mjs",
    "cc98-searchpro-auth": "runtime/cli.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-runtime.mjs",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "node --test tests/*.test.ts",
    "start": "node runtime/server.mjs",
    "configure": "python3 scripts/login.py",
    "status": "node runtime/cli.mjs status --check",
    "check": "npm run typecheck && npm test && npm run test:installer && npm run build && npm run test:runtime",
    "prepack": "npm run build",
    "test:runtime": "node --test tests/runtime.test.mjs",
    "test:installer": "python3 -m unittest discover -s tests -p \"*_test.py\"",
    "release:package": "npm run check && python3 scripts/package-release.py"
  },
  "files": [
    "dist",
    "src",
    "tests/*.ts",
    "tests/*.mjs",
    "tests/*_test.py",
    "tsconfig.json",
    "tsconfig.tests.json",
    "npm-shrinkwrap.json",
    "scripts/*.mjs",
    "scripts/*.py",
    "scripts/*.sh",
    "skills",
    ".codex-plugin",
    ".mcp.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "runtime/*.mjs",
    "runtime/*.txt",
    "PRIVACY.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "author": "Vita0818",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vita0818/CC98-SearchPro.git"
  },
  "homepage": "https://github.com/Vita0818/CC98-SearchPro",
  "bugs": {
    "url": "https://github.com/Vita0818/CC98-SearchPro/issues"
  },
  "keywords": [
    "cc98",
    "search",
    "mcp",
    "codex",
    "zju"
  ]
}
